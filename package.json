{
  "name": "commit-jazzer",
  "version": "2.0.1",
  "description": "Conventional Commits with emoji: an interactive CLI, a git hook and a Commitizen adapter. Fuzzy type search, scopes, breaking changes, issue footers, 13 languages and a typed config.",
  "keywords": [
    "cli",
    "commit",
    "commit-helper",
    "commit-message",
    "commit-msg",
    "commitizen",
    "commitizen-adapter",
    "commitlint",
    "conventional-changelog",
    "conventional-commits",
    "cz-adapter",
    "emoji",
    "emoji-commits",
    "git",
    "git-hooks",
    "gitmoji",
    "husky",
    "prepare-commit-msg",
    "semantic-release"
  ],
  "homepage": "https://zilero232.github.io/commit-jazzer/",
  "bugs": {
    "url": "https://github.com/Zilero232/commit-jazzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/commit-jazzer.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Zilero232"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./schema.json": "./schema.json"
  },
  "main": "./index.cjs",
  "types": "./index.d.cts",
  "bin": {
    "commit-jazzer": "dist/cli.mjs",
    "jazzer": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "index.cjs",
    "index.d.cts",
    "schema.json"
  ],
  "scripts": {
    "build": "bun scripts/generate-schema.ts && tsdown",
    "commit": "bun run build && node ./dist/cli.mjs",
    "docs:build": "vitepress build site",
    "docs:dev": "vitepress dev site",
    "fix": "eslint . --fix && prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "prepublishOnly": "bun run build",
    "spell": "cspell lint --config ./cspell.json --gitignore --no-progress --no-must-find-files .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run spell && knip"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml}": "prettier --write",
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.vue": "eslint --fix"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@inquirer/editor": "^5.3.4",
    "@inquirer/input": "^5.1.7",
    "@inquirer/search": "^4.3.4",
    "@inquirer/select": "^5.2.6",
    "commander": "^15.0.0",
    "figlet": "^1.12.0",
    "fuse.js": "^7.5.0",
    "handlebars": "^4.7.10",
    "jiti": "^2.7.0",
    "lilconfig": "^3.1.4",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/lint": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@siberiacancode/eslint": "^2.18.1",
    "@siberiacancode/prettier": "^1.9.0",
    "@siberiacancode/tsconfig": "^1.2.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-commits-parser": "^7.1.3",
    "cspell": "^10.4.0",
    "escape-string-regexp": "^5.0.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "knip": "^6.42.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "publint": "^0.3.25",
    "remeda": "^2.52.0",
    "semantic-release": "^25.0.9",
    "ts-pattern": "^5.9.2",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
