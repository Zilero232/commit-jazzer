{
  "name": "commit-jazzer",
  "type": "module",
  "version": "1.1.5",
  "packageManager": "bun@1.3.14",
  "description": "Conventional Commits with emoji: an interactive CLI, a git hook and a Commitizen adapter. Fuzzy type search, scopes, breaking changes, issue footers, 13 languages and a typed config.",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Zilero232"
  },
  "homepage": "https://zilero232.github.io/commit-jazzer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/commit-jazzer.git"
  },
  "bugs": {
    "url": "https://github.com/Zilero232/commit-jazzer/issues"
  },
  "keywords": [
    "git",
    "commit",
    "conventional-commits",
    "commitizen",
    "cz-adapter",
    "commitlint",
    "semantic-release",
    "gitmoji",
    "emoji",
    "prepare-commit-msg",
    "cli"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "main": "./index.cjs",
  "types": "./index.d.cts",
  "bin": {
    "commit-jazzer": "./dist/cli.mjs",
    "jazzer": "./dist/cli.mjs"
  },
  "files": [
    "!dist/cli.d.mts",
    "dist",
    "index.cjs",
    "index.d.cts",
    "schema.json"
  ],
  "config": {
    "commitizen": {
      "path": "./index.cjs"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "bun run generate-schema && tsdown",
    "dev": "tsdown --watch",
    "docs:dev": "bun run generate-schema && vitepress dev docs",
    "docs:build": "bun run generate-schema && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "generate-schema": "bun ./scripts/generate-schema.ts",
    "generate-fonts": "bun ./scripts/generate-fonts.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell": "cspell lint --config ./cspell.json --gitignore --no-progress --no-must-find-files .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run spell && bun run knip",
    "fix": "bun run lint:fix && bun run format",
    "commit": "bun run build && node ./dist/cli.mjs",
    "prepublishOnly": "bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@inquirer/editor": "^5.3.4",
    "@inquirer/input": "^5.1.7",
    "@inquirer/search": "^4.3.4",
    "@inquirer/select": "^5.2.6",
    "figlet": "^1.12.0",
    "fuse.js": "^7.5.0",
    "handlebars": "^4.7.10",
    "jiti": "^2.7.0",
    "lilconfig": "^3.1.4",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/lint": "^21.2.4",
    "@cspell/dict-ru_ru": "^2.3.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@siberiacancode/eslint": "^2.18.1",
    "@siberiacancode/prettier": "^1.9.0",
    "@siberiacancode/tsconfig": "^1.2.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-commits-parser": "^7.1.3",
    "cspell": "^10.4.0",
    "escape-string-regexp": "^5.0.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "knip": "^6.42.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "remeda": "^2.52.0",
    "semantic-release": "^25.0.9",
    "ts-pattern": "^5.9.2",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
