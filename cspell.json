{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "node_modules",
    "dist",
    "coverage",
    "bun.lock",
    "schema.json",
    "CHANGELOG.md",
    "site/.vitepress/cache",
    "site/.vitepress/dist",
    "**/profanity.constants.ts",
    "**/locales/*.json",
    "**/commit-types.constants.ts",
    "**/*.svg",
    "**/figlet-fonts.constants.ts"
  ],
  "words": [
    "Alexandr",
    "Artemev",
    "badword",
    "badwords",
    "bogdan",
    "breakline",
    "Catppuccin",
    "CLI",
    "commitizen",
    "commitlint",
    "cts",
    "czrc",
    "EDITMSG",
    "figlet",
    "gitmoji",
    "giu",
    "gpgsign",
    "jazzer",
    "jazzerrc",
    "jdx",
    "jiti",
    "knip",
    "languge",
    "lilconfig",
    "llms",
    "llmstxt",
    "mktemp",
    "mts",
    "NOSYSTEM",
    "oleg",
    "pathspec",
    "prefault",
    "publint",
    "remeda",
    "Scriptable",
    "seo",
    "siberiacancode",
    "smushing",
    "tsdown",
    "ttyd",
    "unmatch",
    "unstub",
    "worktrees",
    "zilero"
  ],
  "ignoreRegExpList": ["[\\u0400-\\u04FF]+"]
}
